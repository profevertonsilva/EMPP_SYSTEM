# EMPP v2 environment. Copy to .env and fill in.

# ---------------------------------------------------------------------------
# v2 database (its own database, never the v1 one).
# Create it and its tables with: php bin/migrate.php --create
DB_HOST=localhost
DB_PORT=3306
DB_NAME=empp_v2
DB_USER=
DB_PASS=

# Database for the automated tests. It is DROPPED and recreated on every test
# run, so the name must end in _test.
TEST_DB_NAME=empp_v2_test
# v1-shaped database the importer tests build and drop (must end in _test)
TEST_V1_DB_NAME=empp_v1_test

# ---------------------------------------------------------------------------
# v1, read by bin/import-v1.php only (read-only session).
# Host, port, user and password default to the DB_* ones above when empty.
V1_DB_NAME=empp
V1_DB_HOST=
V1_DB_USER=
V1_DB_PASS=
# v1 application folder, to copy uploaded images and photos from
V1_PATH=..
