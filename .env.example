# EMPP environment
# Copy to .env and fill in. Every variable below is read by the code;
# a missing one breaks the pages that use it.

# ---------------------------------------------------------------------------
# Site address: the ONLY URL to change per environment.
# - Must end with a slash (the code appends paths like 'dashboard/...').
# - Must match how the site is really served:
#     local `php -S localhost:8000`  -> http://localhost:8000/
#     production                     -> https://your-domain/
# - The app runs at the domain root, never in a subfolder.
BASE_URL=http://localhost:8000/

# Asset URLs, built from BASE_URL. Leave as they are.
BASE_ASSETS="${BASE_URL}resources/dashboard/assets/"
BASE_CSS="${BASE_URL}resources/dashboard/assets/css/"
BASE_JS="${BASE_URL}resources/dashboard/assets/js/"
BASE_VENDOR="${BASE_URL}resources/dashboard/assets/vendor/"
# Also sent to the external Haralick API as the image address, so in
# production it must be publicly reachable.
BASE_IMG="${BASE_URL}resources/dashboard/assets/img/"

SITE_TITLE_HOME="EMPP - Electrospun Membrane Property Predictor"

# ---------------------------------------------------------------------------
# Database (MySQL/MariaDB)
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# ---------------------------------------------------------------------------
# SMTP for the 6-digit codes (email verification, password reset).
# Port 465 uses implicit TLS; any other port uses STARTTLS.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
# Sender address; leave empty to send from MAIL_USER
MAIL_FROM=
MAIL_FROM_NAME=EMPP

# ---------------------------------------------------------------------------
# Not used by the code yet
JWT_SECRET=
GOOGLE_MAPS_API_KEY=

# Values with spaces or # go in double quotes.
